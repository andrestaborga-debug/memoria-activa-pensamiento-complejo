# Cloudflare Pages _headers — security headers.
# https://developers.cloudflare.com/pages/configuration/headers/

# --- Strict policy for the password manager (fully self-contained page) ---
# connect-src 'self' keeps the decrypted vault from being exfiltrated to any
# other origin; the only allowed fetch target is the same-origin /api/vault.
/password-manager.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Cross-Origin-Opener-Policy: same-origin

# --- API responses: never cached, never sniffed ---
/api/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cache-Control: no-store

# --- Light hardening for the rest of the static site ---
# (no CSP here: these pages load Google Fonts / KaTeX / p5.js from CDNs)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
